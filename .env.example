# Copy to .env and replace every placeholder before starting the deployment.
POSTGRES_DB=crashsense
POSTGRES_USER=crashsense_app
POSTGRES_PASSWORD=replace_with_a_unique_long_database_password
JWT_SECRET_KEY=replace_with_at_least_32_random_characters

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_16_characters
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator

# Public browser origin. Keep the application behind HTTPS in production.
FRONTEND_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_MAX_VIDEO_UPLOAD_SIZE_MB=100
