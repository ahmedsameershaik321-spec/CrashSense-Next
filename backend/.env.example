APP_NAME=CrashSense API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
VIDEO_STORAGE_DIR=storage/videos
MAX_VIDEO_UPLOAD_SIZE_MB=100
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
DETECTION_MODEL_WEIGHTS=yolov8n.pt
DETECTION_DEVICE=auto
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45
DETECTION_FRAME_INTERVAL_SECONDS=1.0
DETECTION_MAX_FRAME_DIMENSION=1280
DETECTION_MIN_CANDIDATE_OBSERVATIONS=2
DETECTION_MIN_VERIFIED_OBSERVATIONS=4
DETECTION_MIN_MOTION_EVENTS=2
DETECTION_INTERACTION_DISTANCE_RATIO=0.08
DETECTION_MIN_SPEED_PIXELS_PER_SECOND=12.0
DETECTION_STOP_SPEED_RATIO=0.2
DETECTION_WORKER_POLL_SECONDS=1.0
DETECTION_STALE_JOB_MINUTES=60
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_TIMEOUT_SECONDS=10.0

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crashsense
DATABASE_USER=crashsense_app
DATABASE_PASSWORD=replace_with_a_local_database_password

JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator